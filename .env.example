# Customer-facing bot (BotFather token) - handles group/channel members
CUSTOMER_BOT_TOKEN=

# Personal/admin bot (separate BotFather token) - your private assistant
ADMIN_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Telethon user-session credentials (my.telegram.org) - used only to read
# messages from public channels/groups you have personally joined
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION_NAME=content_listener
# For headless hosting (Railway): generate this once with generate_session.py
# and paste it here / into Railway. Leave blank for local runs (interactive login).
TELETHON_SESSION_STRING=

# Comma-separated usernames or IDs of source channels/groups you've joined
SOURCE_CHATS=

# Your own group/channel that receives copied + AI-generated content
DESTINATION_CHAT_ID=

# AI routing (OpenRouter gateway - covers Anthropic/OpenAI/DeepSeek behind one API)
# deepseek/deepseek-chat is cheap and reliable. Other verified-working options:
# openai/gpt-4o-mini. Note: Anthropic models may need enabling on your OpenRouter
# account before they work.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Scheduling
TIMEZONE=UTC
MORNING_TIME=08:00
NIGHT_TIME=21:00

# Storage
DB_PATH=data/app.db

# Web dashboard (Phase 2). Set a strong password to enable it; leave blank to
# disable. Log in with any username and this password. On Railway, generate a
# public domain and it will set PORT automatically.
DASHBOARD_PASSWORD=
PORT=8080
